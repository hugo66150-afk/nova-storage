{
  "name": "nova-storage",
  "productName": "Nova Storage",
  "version": "1.1.0",
  "description": "Nova Storage — Le gestionnaire intelligent du stockage Windows.",
  "main": "dist/main/main/index.js",
  "author": "Nova Storage",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.novastorage.app",
    "productName": "Nova Storage",
    "asar": true,
    "files": [
      "dist/**/*",
      "!**/*.map",
      "preload.cjs",
      "package.json",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hugo66150-afk",
        "repo": "nova-storage"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "artifactName": "Nova-Storage-Setup-x64.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/branding/nova.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Storage"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
